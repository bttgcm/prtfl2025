/*-- scss:defaults --*/

// Import Google Fonts
@import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap');


@import url('https://fonts.googleapis.com/css2?family=Cal+Sans&family=Lexend:wght@100..900&display=swap');

// Harry Atkins inspired design - brutalist, minimal, high contrast
$body-color: #000000;
$body-bg: #ffffff;

// Accent colors
$accent-link: #FF3366;
$accent-title: #000000;  // Changed to black for headings

$link-color: #232424;
$link-hover-color: $accent-link;

// Typography - Inter for sans-serif, JetBrains Mono for code
$font-family-sans-serif: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
$font-family-monospace: "JetBrains Mono", "Courier New", Courier, monospace;

$headings-font-family: $font-family-sans-serif;
$headings-font-weight: 400;
$headings-color: $accent-title;

// Base font size
$font-size-base: 1rem;

// Spacing
$navbar-padding-y: 1.5rem;
$navbar-padding-x: 2rem;

/*-- scss:rules --*/

body {
  font-weight: 400;
  letter-spacing: -0.01em;
}

.navbar {
  border-bottom: 1px solid #000000;
  box-shadow: none;
  background-color: #ffffff;
}

.navbar-brand {
  font-weight: 400;
  font-size: 1rem;
  letter-spacing: -0.01em;
  text-transform: none;
}

.navbar-nav {
  font-size: 1rem;
}

.navbar-nav .nav-link {
  color: #000000;
  font-size: 1rem;
  padding: 0.5rem 1.25rem;
  font-weight: 400;
  letter-spacing: -0.01em;
  transition: color 0.2s ease;
}

.navbar-nav .nav-link:hover {
  color: #232424;
}

.navbar-nav .nav-link.active {
  font-weight: 400;
  color: #000000;
}

h1, h2, h3, h4, h5, h6 {
  margin-top: 2em;
  margin-bottom: 1em;
  line-height: 1.2;
  font-weight: 400;
  letter-spacing: -0.02em;
  color: $headings-color;  // Explicitly set to use black
}

h1 {
  font-size: 2.5rem;
  border-bottom: none;
  padding-bottom: 0;
  margin-top: 0;
}

h2 {
  font-size: 1.75rem;
  margin-top: 2.5em;
  font-family: 'Lexend', Georgia, serif;
  font-weight: 600;
}

h3 {
  font-size: 1.25rem;
}

p {
  line-height: 1.6;
  margin-bottom: 1.5em;
  font-size: 1rem;
}

a {
  text-decoration: none;
  border-bottom: 1px solid #232424;
  transition: all 0.2s ease;
  color: #232424;
}

a:hover {
  color: $accent-link;
  border-bottom-color: $accent-link;
}

code {
  background-color: #f5f5f5;
  padding: 0.2em 0.4em;
  border: 1px solid #e0e0e0;
  border-radius: 0;
  font-size: 0.9em;
  font-family: $font-family-monospace;
}

pre {
  background-color: #f5f5f5;
  border: 1px solid #000000;
  border-radius: 0;
  padding: 1rem;
}

blockquote {
  border-left: 2px solid #000000;
  padding-left: 1.5rem;
  margin: 2rem 0;
  font-style: normal;
}

hr {
  border: none;
  border-top: 1px solid #000000;
  margin: 3rem 0;
}

.quarto-title-block {
  border-bottom: 1px solid #000000;
  padding-bottom: 2rem;
  margin-bottom: 3rem;
}

.quarto-title {
  font-weight: 400;
  margin-bottom: 0.5rem;
}
