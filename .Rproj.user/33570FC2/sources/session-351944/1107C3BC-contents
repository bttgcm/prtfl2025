library(plotly)
# axis layout
axis <- function(title) {
  list(
    title = title,
    titlefont = list(
      size = 10
    ),
    tickfont = list(
      size = 7
    ),
    tickcolor = 'rgba(0,0,0,0)',
    ticklen = 5
  )
}


fig <- df %>% plot_ly()
fig <- fig %>% add_trace(
  type = 'scatterternary',
  mode = 'markers',
  a = ~N,
  b = ~H,
  c = ~B,
  text = ~role,
  hoverinfo = "text",
  hovertext = paste("Species :", df$role,
                    "<br> Avg :", df$year),
  color= ~area,
  colors = c("red", "blue")
)
summary(df)
fig <- fig %>% layout(
  title = "",
  ternary = list(
    sum = 100,
    aaxis = axis('Natural environment'),
    baxis = axis('Human society'),
    caxis = axis('Built environment'),
    plot_bgcolor = "rgba(0,0,0,0)",
    paper_bgcolor = "rgba(0,0,0,0)",
    annotations = list(
      list(xref = "paper", yref = "paper", align = "center",
           x = 0.1, y = 1, text = "Ternary Plot in R
(Markers)", ax = 0, ay = 0,
           font = list(family = "serif", size = 15, color = "#EEEEEE"),
           bgcolor = "#b3b3b3", bordercolor = "black", borderwidth = 2)))
)


