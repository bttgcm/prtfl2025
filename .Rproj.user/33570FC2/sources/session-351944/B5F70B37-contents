```{ojs}
  pKa = (2729.92 / (temp + 273.15)) + 0.090181
  f_nh3 = 1 / (10 ** (pKa - pH) + 1)
  TAN = (dry * 0.145) + (urea * 0.466)
  NH3aq = TAN * f_nh3
  duration = -5 / (-0.8 * ((NH3aq / 14.01) * 1000) * 0.0037 * Math.exp(0.066 * temp))
  C_n = dry * 0.171 + urea * 0.466
  application = n_target / C_n
  land = va_vol / application

