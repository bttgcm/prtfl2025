fig <- df %>% plot_ly()
fig <- df %>% plot_ly()
library(ggtern)
library(ggplot2)
library(readr)
library(wesanderson)
library(ggalt)
library(ggplotlyExtra)
library(plotly)
df <- read_csv("career_data.csv")
pal <- wes_palette("Darjeeling1", 25, type = "continuous")
ggplotly(ggtern(data=df,aes(N,B,H, size=Ratio, alpha=0.3)) +
geom_point(aes(color = year))+
labs(x="Natural environmnet",y="Built environment",z="Human society",title="Title")+
theme_classic()+theme_hidelabels()+theme_hidetitles()+
labs(title="",x ="Natural environment", y = "Built environment", z="Human society")+
theme_showarrows()+
scale_color_gradient(low = "#555555", high = "#ff6666")+
theme(panel.background = element_rect(fill = '#EEEEEE')))
+geom_encircle(alpha=0.5,size=1)
+
scale_color_gradient(low = "#555555", high = "#ffb3b3")
scale_color_gradient(pal)
ggplotly(sp<-ggplot(mtcars, aes(x=wt, y=mpg, color=cyl)) + geom_point())
ggplotly(sp+scale_fill_manual(values=wes_palette(n=3, name="Zissou1")))
sp+scale_fill_manual(values=wes_palette(n=3, name="IsleofDogs2"))
# heatmap is a local dataset
ggplot(heatmap, aes(x = X2, y = X1, fill = value)) +
geom_tile() +
scale_fill_gradientn(colours = pal) +
scale_x_discrete(expand = c(0, 0)) +
scale_y_discrete(expand = c(0, 0)) +
coord_equal()
# with plotly
library(plotly)
# axis layout
axis <- function(title) {
list(
title = title,
titlefont = list(
size = 10
),
tickfont = list(
size = 7
),
tickcolor = 'rgba(0,0,0,0)',
ticklen = 5
)
}
fig <- df %>% plot_ly()
fig <- fig %>% add_trace(
type = 'scatterternary',
mode = 'markers',
a = ~N,
b = ~H,
c = ~B,
text = ~role,
hoverinfo = "text"
)
fig <- fig %>% layout(
title = "",
ternary = list(
sum = 100,
aaxis = axis('Natural environment'),
baxis = axis('Human society'),
caxis = axis('Built environment'),
annotations = list(
list(xref = "paper", yref = "paper", align = "center",
x = 0.1, y = 1, text = "Ternary Plot in R
(Markers)", ax = 0, ay = 0,
font = list(family = "serif", size = 15, color = "#EEEEEE"),
bgcolor = "#b3b3b3", bordercolor = "black", borderwidth = 2)))
)
fig
ggplotly(sp<-ggplot(mtcars, aes(x=wt, y=mpg, color=cyl)) + geom_point())
ggplotly(ggtern(data=df,aes(N,B,H, size=Ratio, alpha=0.3)) +
geom_point(aes(color = year))+
labs(x="Natural environmnet",y="Built environment",z="Human society",title="Title")+
theme_classic()+theme_hidelabels()+theme_hidetitles()+
labs(title="",x ="Natural environment", y = "Built environment", z="Human society")+
theme_showarrows()+
scale_color_gradient(low = "#555555", high = "#ff6666")+
theme(panel.background = element_rect(fill = '#EEEEEE')))
