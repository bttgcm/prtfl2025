# Individual lines with professional palette
geom_line(linewidth = 1.1, alpha = 0.8) +
geom_point(size = 2.2, alpha = 0.9) +
# Smooth trend line (all data combined)
geom_smooth(aes(group = 1), method = "loess", color = "black",
linewidth = 1.5, se = TRUE, alpha = 0.3) +
scale_color_viridis_d(option = "plasma", name = "Variable") +  # Professional palette
scale_linetype_manual(values = line_types, name = "Variable") +
# Legend optimization: vertical, compact
guides(color = guide_legend(ncol = 2, byrow = TRUE),
linetype = guide_legend(ncol = 2, byrow = TRUE)) +
labs(title = "Mean Values by Year (Filtered: 0,1,2 only)",
subtitle = "Black smooth line shows overall trend | 18 Variables",
x = "Year", y = "Mean Value") +
theme_minimal(base_size = 12) +
theme(
legend.position = "bottom",
legend.direction = "horizontal",
legend.box = "vertical",
legend.box.just = "center",
legend.text = element_text(size = 9),
legend.title = element_text(size = 10, face = "bold"),
plot.title = element_text(size = 14, face = "bold"),
plot.subtitle = element_text(size = 11, color = "grey50")
)
